# PatchPilot Environment Configuration
# Copy this file to .env to configure optional parameters.
# Never commit real credentials or API keys to source control.

# Server Configuration
PATCHPILOT_HOST=127.0.0.1
PATCHPILOT_PORT=5000

# Optional Nebius AI Studio Provider Configuration
# Leave blank to use the built-in deterministic rule analyzer.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
NEBIUS_TIMEOUT_SEC=15
